{% extends 'base.html.twig' %}

{% block title %}Ecoride | Rechercher{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="text-center text-success">🌱 Rechercher un trajet 🌱</h1>

    {{ form_start(form) }}<br>
    <div class="row my-1">
        <div class="col-md-4 text-success">
            {{ form_row(form.villeDepart) }}
        </div>
        <div class="col-md-4 text-success">
            {{ form_row(form.villeArrivee) }}
        </div>
        <div class="col-md-4 text-success">
            {{ form_row(form.date) }}
        </div>
    </div>
    <button class="btn btn-success w-100 mt-3">Rechercher</button>
    {{ form_end(form) }}

    <hr>

    {% if trajets is not empty %}
        <h2 class="mt-5">Résultats :</h2>
        {% for trajet in trajets %}
            <div class="card my-3 p-3">
                <h5>Trajet de {{ trajet.villeDepart }} à {{ trajet.villeArrivee }}</h5>
                <p>Date : {{ trajet.dateDepart|date('d/m/Y H:i') }}</p>
                <p>Places restantes : {{ trajet.nbPlaces }}</p>
                <p>Prix : {{ trajet.prix }} €</p>
                {% if trajet.vehicule and trajet.vehicule.isElectrique %}
                    <p class="text-success">🌱 Voyage écologique</p>
                {% endif %}
                <a href="{{ path('trajet_detail', { id: trajet.id }) }}" class="btn btn-outline-success">Détail</a>
            </div>
        {% endfor %}
    {% elseif form.vars.submitted %}
        <p class="text-danger">Aucun trajet trouvé.</p>
    {% endif %}
</div>
{% endblock %}

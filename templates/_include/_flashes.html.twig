{% for notification in app.flashes ('success') %}
	<di class="alert alert-success w-75 mx-auto text-center my-2">
		{{notification}}

	</div 
{% endfor %}

{% for notification in app.flashes ('warning') %}
	<di class="alert alert-warning  w-75 mx-auto text-center my-2">
		{{notification}}

	</div 
{% endfor %}

{% for notification in app.flashes ('error') %}
	<di class="alert alert-danger w-75 mx-auto text-center my-2">
		{{notification}}

	</div 
{% endfor %}


{% extends 'base.html.twig' %}

{% block title %}Ecoride | Avis voyageur
{% endblock %}

{% block body %}
	<div class="py-5 ">
		<div class="container py-5 ">
			<div
				class="row justify-content-center align-items-start align-items-enter g-4">


				<!-- Colonne formulaire -->
				<div class="col-lg-5  p-5 py-5 rounded-4 shadow mt-5" data-aos="fade-left">
					<h2 class="text-success text-center mb-4" data-aos="fade-up">📨 Votre avis nous interesse | Ecoride
					</h2>
					<p class="text-center text-success"> 🌱 {{trajet.villeDepart}}
						-
						{{trajet.villeArrivee}} 🌱
					</p>

					{{ form_start(formAvis) }}

					<div class="form-group mb-3" data-aos="fade-up" data-aos-delay="100">
						{{ form_row(formAvis.note, {attr:{'class': 'form form-control mt-2 '}}) }}
					</div>

					<div class="form-group mb-3" data-aos="fade-up" data-aos-delay="200">
						{{ form_row(formAvis.commentaire, {attr:{'class': 'form form-control mt-2'}}) }}
					</div>
					
					<div class="form-group mb-3" data-aos="fade-up" data-aos-delay="200">
						{{ form_row(formAvis.trajet_mal_passe, {attr:{'class': 'form form-control mt-2'}}) }}
					</div>


					<div class="text-center" data-aos="fade-up" data-aos-delay="600">
						<button type="submit" class="btn btn-success w-100">Envoyer</button>
					</div>

					{{ form_end(formAvis) }}

				</div>

			</div>
		</div>
	</div>
{% endblock %}

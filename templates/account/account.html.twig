{% extends 'base.html.twig' %}

{% block title %}Ecoride | Mon compte{% endblock %}

{% block body %}
<div class="container mt-4 ">
    <h2 class="text-success text-center">🌱 Mon Profil 🌱</h2><br>

    <div class="row mt-4 ">
        <div class="col-md-4 mb-3 ">
            <div class="card p-3 shadow-sm text-center border border-success rounded">
                <img src="{{ asset('uploads/photos/' ~ user.photo) }}" class="rounded-circle mb-2" width="100">
                <h4 class="text-success "> {{ user.pseudo }}</h4>
                <span class="badge bg-success">Actif</span><br>
                <span class="badge bg-primary mt-3">{{ user.credits }} crédits</span><br>
                <a href="#" class="btn btn-outline-success mt-3">Recharger mes crédits</a>
                <a href="#" class="btn btn-outline-success mt-3">Proposer un trajet</a>
            </div>
        </div>

        <div class="col-md-8 mb-3">
            <div class="card p-4 shadow-sm  border border-success rounded">
                <h5 class="text-success">🌱 Informations personnelles</h5>
                <p><strong class="text-success">🌱 Email :</strong> {{ user.email }}</p>
                <p><strong class="text-success">🌱 Téléphone :</strong> Non renseigné</p>

                <hr>

                <h5 class="text-success">Statistiques</h5>
                <p >🚗 <span class="text-success">Trajets effectués : </span>0</p>
                <p >🛣  <span class="text-success">Distance parcourue : </span>0 km</p>
                <p >🌿 <span class="text-success">CO2 économisé :</span>  0 kg</p>

                <hr>

                <h5 class="text-success">Mode conducteur</h5>
                <p>Activez le mode conducteur pour proposer des trajets et gagner des crédits.</p>
                <a href="#" class="btn btn-outline-success">Devenir chauffeur</a>
            </div>
        </div>
    </div>
</div>


{% endblock %}

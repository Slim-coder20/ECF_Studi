{% extends 'base.html.twig' %}
{% block title %}Ecoride |Mes trajets conducteur
{% endblock %}

{% block body %}
	<div class="container mt-4">
		<h1 class="text-success ">
			🌱 Mes Trajets conducteur 🌱</h1>

		{% if Trajets_conduits is not empty %}
			<table class="table table-striped mt-3 ">
				<thead>
					<tr>
						<th class="text-success ">Trajet</th>
						<th class="text-success ">Départ</th>
						<th class="text-success ">Arrivée</th>
						<th class="text-success ">Date de Départ</th>
						<th class="text-success ">Date d'arrivée</th>
						<th class="text-success ">Nombre de places</th>
						<th class="text-success ">Prix</th>
						<th class="text-success ">Statut Trajet</th>
						<th class="text-success ">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for trajet in Trajets_conduits %}
						<tr>
							<td>
								<a href="{{ path('app_details_trajet', {'id': trajet.id}) }}" class="text-decoration-none text-success">{{ trajet.villeDepart }}
									-
									{{ trajet.villeArrivee }}</a>
							</td>
							<td>{{trajet.villeDepart}}</td>
							<td>{{trajet.villeArrivee}}</td>
							<td>{{ trajet.dateDepart ? trajet.dateDepart|date('d/m/Y ') : 'N/A' }}</td>
							<td>{{ trajet.dateArrivee ? trajet.dateDepart|date('d/m/Y ') : 'N/A' }}</td>
							<td>{{trajet.nbPlaces}}</td>
							<td>{{trajet.prix}}
								€</td>
							<td>
								{% if trajet.statut == 'planifié' %}
									<span class="badge bg-info text-primary">Planifié</span>
								{% elseif trajet.statut == 'complet' %}
									<span class="badge bg-primary">Complet</span>
								{% elseif trajet.statut == 'en_cours'%}
									<span class="badge bg-secondary"></span>
								{% elseif  trajet.statut == 'annulé_par_chauffeur'%}
									<span class="badge bg-danger">Annulé par vous</span>
								{% elseif trajet.statut == 'terminé' %}
									<span class="badge bg-success">Terminé</span>
								{% else %}
									<span class="badge bg-light text-dark">{{ trajet.statut|default('N/D')|capitalize }}</span>

								{% endif %}

							</td>
							<td>
								{# Action pour le chauffeur  #}
								{% if trajet.statut == 'planifié' or trajet.statut == 'complet'%}
									<div class="btn-group" role="group" aria-label="Actions chauffeur">
										{# je créé un systeme de formulaire pour gérer démarrer un trajet ce qui me permeettra d'introduire le csrf_token pour la sécurité  #}
										{# Formulaire pour démarer le Trajet  #}
											<form method="post" action="{{ path('app_trajet_demarrer', {'id': trajet.id}) }}"> <input type="hidden" name="_token" value="{{ csrf_token('demarrer_trajet' ~ trajet.id) }}">
											<button type="submit" class="btn btn-sm-success">Démarer</button>
										</form>
										{# Formulaire pour annuler le Trajet #}
											<form method="post" action="{{ path('app_trajet_annuler', {'id': trajet.id}) }}"> <input type="hidden" name="_token" value="{{ csrf_token('annuler_trajet_chauffeur' ~ trajet.id) }}">
											<button type="submit" class="btn btn-sm-success">Annuler</button>
										</form>

									</div>
									{% elseif trajet.statut == 'en_cours '%} 
									{# Formulaire arrivé a destination  #}
										<form method="post" action="{{ path('app_trajet_terminer_chauffeur', {'id': trajet.id}) }}"> <input type="hidden" name="_token" value="{{ csrf_token('terminer_trajet_chauffeur' ~ trajet.id) }}">
											<button type="submit" class="btn btn-sm-success">Arrivé(e) à destination</button>
										</form>
									{% elseif  trajet.statut == 'annulé_par_chauffeur'%}
									<span class="text-muted">Déjà annulé</span>
									{% elseif  trajet.statut == 'terminé'%}
									<span class="text-muted">Trajet terminé</span>
									{% else %}
									<span class="text-muted">--</span>
									{% endif %}
							</td>


						</tr>

					{% endfor %}

				</tbody>
			</table>
		{% else %}
			<p class="mt-3">Vous n'avez participé à aucun covoiturage pour le moment.</p>
		{% endif %}

		<a href="{{ path('app_account') }}" class="btn btn-outline-success mt-3">Retour à mon compte</a>
	</div>
{% endblock %}

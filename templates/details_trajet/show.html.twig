{% extends 'base.html.twig' %}

{% block title %}Détail du trajet{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="text-center text-success"> 🌱 Détails du trajet 🌱</h1><br>

    <div class="row">
        <!-- Carte 1 : Infos du trajet -->
        <div class="col-md-4 mb-4">
            <div class="card shadow p-4 border-success">
                <h4 class="text-success"> 🌱 Trajet</h4>
                <p><strong class="text-success">Départ :</strong> {{ trajet.villeDepart }}</p>
                <p><strong class="text-success">Arrivée :</strong> {{ trajet.villeArrivee }}</p>
                <p><strong class="text-success">Date de départ :</strong> {{ trajet.dateDepart|date('d/m/Y H:i') }}</p>
                <p><strong class="text-success">Date d’arrivée :</strong> {{ trajet.dateArrivee|date('d/m/Y H:i') }}</p>
                <p><strong class="text-success"> Places restantes :</strong> {{ trajet.nbPlaces }}</p>
                <p><strong class="text-success">Prix :</strong> {{ trajet.prix }} €</p>
            </div>
        </div>

        <!-- Carte 2 : Infos chauffeur avec photo à gauche -->
        <div class="col-md-4 mb-4">
            <div class="card shadow p-4 border-success">
                <h4 class="text-success"> 🌱 Chauffeur</h4>

                <div class="d-flex align-items-center ">
                    {% if trajet.chauffeur.photo %}
                        <img src="{{ asset('uploads/photos/' ~ trajet.chauffeur.photo) }}"
                             alt="Photo du chauffeur"
                             class="rounded-circle me-3"
                             style="width: 80px; height: 80px; object-fit: cover;">
                    {% endif %}

                    <div>
                        <p><strong class="text-success">Pseudo :</strong> {{ trajet.chauffeur.pseudo }}</p>
                        <p><strong class="text-success">Nom :</strong> {{ trajet.chauffeur.lastName }}</p>
                        <p><strong class="text-success">Prénom :</strong> {{ trajet.chauffeur.firstName }}</p>
                        <p><strong class="text-success">Email :</strong> {{ trajet.chauffeur.email }}</p>
                        <p><strong class="text-success">Note :</strong> {{ trajet.chauffeur.moyenneAvis ?? 'Pas encore noté'}}</p>
                    </div>
                </div>
            </div>
        </div>
        <!-- Avis sur le conducteur --> 
      <div class="col-md-4 mb-4">
    <div class="card shadow p-4 border-success">
        <h4 class="text-success">🌱 Avis sur le conducteur</h4>
        {% if trajet.chauffeur.avis|length > 0 %}
            {% for avis in trajet.chauffeur.avis %}
                <div class="border-bottom pb-2 mb-2">
                    <span class="badge bg-success">Note : {{ avis.note }} / 5</span>
                    {% if avis.commentaire %}
                        <strong class="text-success">Commentaire :</strong> {{ avis.commentaire }}<br>
                    {% endif %}
                    <small class="text-muted">Posté le {{ avis.date|date('d/m/Y') }}
                    par {{ avis.auteur.pseudo }}</small>
                </div>
            {% endfor %}
        {% else %}
            <p>Aucun avis pour ce conducteur.</p>
        {% endif %}
    </div>
    <!--  carte 4: Informatiion sur le vehicule --> 
    <div class="col-md-12 mb-4">
    <div class="card shadow p-4 mt-4 border-success">
        <h4 class="text-success">🌱 Véhicule utilisé</h4>
        {% set vehicule = trajet.chauffeur.vehicules|first %}
        {% if vehicule %}
            
            <p><strong class="text-success">Modèle :</strong> {{ vehicule.modele }}</p>
            <p><strong class="text-success">Marque :</strong> {{ vehicule.marque }}</p>
            <p><strong class="text-success">Énergie :</strong> {{ vehicule.isElectrique ? 'Électrique' : 'Thermique' }}</p>
            <p><strong class="text-success">Fumeur accepté :</strong> {{ vehicule.accepteFumeur ? 'Oui' : 'Non' }}</p>
            <p><strong class="text-success">Animaux acceptés :</strong> {{ vehicule.accepteAnimaux ? 'Oui' : 'Non' }}</p>

            {% if vehicule.photo %}
                <img src="{{ asset('uploads/photos/' ~ vehicule.photo) }}" class="img-fluid rounded mt-2" style="max-height: 150px;">
            {% endif %}
        {% else %}
            <p class="text-muted">Aucun véhicule enregistré pour ce chauffeur.</p>
        {% endif %}
    </div>
</div>

</div>
<div>
    <a href="{{ path('app_search') }}" class="btn btn-outline-success ">Rechercher un Trajet</a>
    
    {% if app.user %}
        <a href="{{ path('app_login') }}" class="btn btn-outline-success">Participer à un trajet</a>
    {% else %}
        <a href="{{ path('app_register') }}" class="btn btn-outline-success">Inscription</a>
    {% endif %}

</div>
    
 
</div>
{% endblock %}

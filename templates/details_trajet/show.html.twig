{% extends 'base.html.twig' %}

{% block title %}Détail du trajet{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="text-success text-center"> 🌱 Détail du trajet 🌱 </h1>

    <div class="card p-4">
        <h3 class="mb-3 text-success"> 🌱 Trajet</h3>
        <p><strong class="text-success">Départ :</strong> {{ trajet.villeDepart }}</p>
        <p><strong class="text-success">Arrivée :</strong> {{ trajet.villeArrivee }}</p>
        <p><strong class="text-success">Date de départ :</strong> {{ trajet.dateDepart|date('d/m/Y H:i') }}</p>
        <p><strong class="text-success">Date d’arrivée :</strong> {{ trajet.dateArrivee|date('d/m/Y H:i') }}</p>
        <p><strong class="text-success">Places restantes :</strong> {{ trajet.nbPlaces }}</p>
        <p><strong class="text-success">Prix :</strong> {{ trajet.prix }} €</p>

        <hr> 

        <h3 class="mb-3 text-success"> 🌱 Chauffeur</h3>
        <p><strong class="text-success">Pseudo :</strong> {{ trajet.chauffeur.pseudo }}</p>
        <p><strong class="text-success">Nom :</strong> {{ trajet.chauffeur.lastName }}</p>
        <p><strong class="text-success">Prénom :</strong> {{ trajet.chauffeur.firstName }}</p>
        <p><strong class="text-success">Email :</strong> {{ trajet.chauffeur.email }}</p>

        {% if trajet.chauffeur.photo %}
            <img src="{{ asset('uploads/photos/' ~ trajet.chauffeur.photo) }}" alt="Photo du chauffeur" class="rounded mt-2" width="150">
        {% else %}
            <p><em>Aucune photo disponible</em></p>
        {% endif %}
    </div>

    <a href="{{ path('app_search') }}" class="btn btn-outline-success mt-4 ">← Retour à la recherche</a>
    <a href="{{path('app_login')}}" class="btn btn-outline-success mt-4">Participer au trajet</a>
</div>
{% endblock %}
